# ── Copy to .env and fill in secrets before running ──────────
APP_NAME="Booking & Queue Auth Service"
APP_ENV=development
DEBUG=true

# !! CHANGE IN PRODUCTION — generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=CHANGE_ME_IN_PRODUCTION_USE_SECRETS_TOKEN_URLSAFE_64

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/booking_db
REDIS_URL=redis://localhost:6379/0

COOKIE_SECURE=false        # true in production (HTTPS only)
COOKIE_DOMAIN=             # set to your domain in production, e.g. bookingapp.com

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

LOGIN_RATE_LIMIT=10/minute
GLOBAL_RATE_LIMIT=200/minute

MAX_FAILED_LOGINS=5
LOCKOUT_DURATION_MINUTES=15
